    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "dodopayments": "^2.45.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "groq-sdk": "^1.2.1",
    "lenis": "^1.3.25",
    "livekit-client": "^2.19.2",
