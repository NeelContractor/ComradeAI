    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "@clerk/nextjs": "^7.4.2",
    "@dodopayments/nextjs": "^0.3.7",
    "@livekit/components-react": "^2.9.21",
    "@livekit/components-styles": "^1.2.0",
    "@milkdown/crepe": "^7.21.1",
    "@neondatabase/serverless": "^1.1.0",
